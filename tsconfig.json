{
  "compilerOptions": {
    "target": "es2022", "module": "nodenext", "moduleResolution": "nodenext",
    "strict": true, "allowImportingTsExtensions": true, "noEmit": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server", "driver", "bridge", "tee", "observe", "verify"]
}
